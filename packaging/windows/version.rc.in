#include <windows.h>
IDI_ICON1 ICON "@CMAKE_CURRENT_SOURCE_DIR@/assets/icons/WorshipCue.ico"
VS_VERSION_INFO VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "CompanyName", "WorshipCue\0"
   VALUE "FileDescription", "WorshipCue Presentation Software\0"
   VALUE "FileVersion", "@PROJECT_VERSION@\0"
   VALUE "ProductName", "WorshipCue\0"
   VALUE "ProductVersion", "@PROJECT_VERSION@ (@WORSHIPCUE_RELEASE_CHANNEL@)\0"
   VALUE "LegalCopyright", "Copyright (c) 2026 Jeremy Kuehn\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x409, 1200
 END
END
