{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "worshipcue-licensing",
  "main": "entry.mjs",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "observability": { "enabled": false },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "worshipcue-licenses",
      "database_id": "b8bd6499-0540-4326-8f1a-60ce75537c72",
      "migrations_dir": "migrations",
    },
  ],
  "ratelimits": [
    {
      "name": "LIMITER",
      "namespace_id": "9001",
      "simple": { "limit": 30, "period": 60 },
    },
  ],
}
